# Live Studionet court. Server-side reads and keeper writes.
ALPHA_COURT_CONTRACT_ADDRESS=0x1b8Fc1a2B16352228f2016DB1BBbeAaBA9192B37

# Same address, baked into the client bundle at build time.
NEXT_PUBLIC_ALPHA_COURT_CONTRACT_ADDRESS=0x1b8Fc1a2B16352228f2016DB1BBbeAaBA9192B37

# Wallet-connect target. Default studionet (chain 61999).
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Optional: public display of the keeper EOA (not a secret).
ALPHA_COURT_SIGNER_ADDRESS=

# Deposit address — the live court itself (treasury SELF). Not a secret.
NEXT_PUBLIC_TREASURY_ADDRESS=0x1b8Fc1a2B16352228f2016DB1BBbeAaBA9192B37

# Frontend may offer demo signing when no wallet is connected.
# Real connected wallets always sign themselves. Default: off.
NEXT_PUBLIC_ALLOW_DEMO_SIGNING=false

# Server-side gate for demo signing. Default: off. Must be "true"
# for any unsigned write to use ALPHA_COURT_SIGNER_PRIVATE_KEY.
ALLOW_DEMO_SIGNING=false

# Funded Studionet account. Keeper native GEN sends + demo writes.
# Never expose to the browser. Never commit a real value.
ALPHA_COURT_SIGNER_PRIVATE_KEY=

# Surf display reads only. Not used by settlement writes.
SURF_API_KEY=

# Settlement keeper. On Vercel, in-process setInterval does not survive;
# use GET/POST /api/keeper/tick (cron) instead.
KEEPER_ENABLED=false
NEXT_PUBLIC_KEEPER_ENABLED=false
KEEPER_MIN_CLAIM_ID=
KEEPER_INTERVAL_MS=60000

# If set, POST /api/keeper/tick and cron GET require Bearer <secret>.
KEEPER_SECRET=

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET=

# Upstash Redis (REST). Required on Vercel — the filesystem is read-only.
# Local `next dev` can omit these and keep using .data/ JSON files.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
